# All optional. With none of these set the API works out of the box (Bing engine).

# Comma-separated list. If set, requests must include ?api_key=<one of these>. Empty = open/unlimited.
API_KEYS=

# Proxy for outgoing requests (residential / unblocker proxy). Comma-separated = random rotation.
# Format: http://user:pass@host:port
PROXY_URL=

# Required for the Google engine on Vercel (it downloads Chromium at runtime).
# Example: https://github.com/Sparticuz/chromium/releases/download/v131.0.1/chromium-v131.0.1-pack.tar
CHROMIUM_PACK_URL=

# Default engine when ?engine is not an explicit one: auto | bing | google
DEFAULT_BACKEND=auto
