{
  "functions": {
    "api/search.js": {
      "maxDuration": 30
    },
    "api/agent.js": {
      "maxDuration": 60,
      "includeFiles": "public/config.js"
    }
  },
  "rewrites": [
    {
      "source": "/search",
      "destination": "/api/search"
    },
    {
      "source": "/search.json",
      "destination": "/api/search"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/openapi"
    }
  ],
  "cleanUrls": true
}